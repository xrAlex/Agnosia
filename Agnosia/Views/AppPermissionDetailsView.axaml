<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Agnosia.ViewModels"
             mc:Ignorable="d"
             x:Class="Agnosia.Views.AppPermissionDetailsView"
             x:DataType="vm:AppItemViewModel">
    <StackPanel Spacing="8">
        <Border Classes="divider" />

        <ToggleButton AutomationProperties.Name="Разрешения приложения" Classes="app-dialog-section-toggle"
                      IsChecked="{Binding IsPermissionDetailsExpanded}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <TextBlock Classes="app-dialog-setting-title"
                           VerticalAlignment="Center"
                           Text="Разрешения приложения" />
                <PathIcon Grid.Column="1"
                          Classes="disclosure-chevron"
                          Classes.expanded="{Binding IsPermissionDetailsExpanded}" />
            </Grid>
        </ToggleButton>

        <StackPanel Spacing="8"
                    IsVisible="{Binding IsPermissionDetailsExpanded}">
            <StackPanel DataContext="{Binding Permissions}" x:DataType="vm:AppPermissionsViewModel" Spacing="10">
                <TextBlock Classes="app-dialog-setting-caption" TextWrapping="Wrap" Text="{Binding Explanation}"
                           IsVisible="{Binding IsWorkProfile}" />
                <TextBlock Classes="app-dialog-setting-caption" Text="{Binding CountText}"
                           IsVisible="{Binding ShowCount}" />
                <TextBox Text="{Binding SearchText}" PlaceholderText="Найти разрешение"
                         AutomationProperties.Name="Поиск разрешений приложения"
                         IsVisible="{Binding IsWorkProfile}" />
                <Button Classes="icon-button" Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Left" AutomationProperties.Name="Обновить статусы разрешений"
                        ToolTip.Tip="Обновить статусы разрешений"
                        IsVisible="{Binding IsWorkProfile}">
                    <PathIcon Classes="action-icon" Data="{StaticResource IconRefreshGeometry}" />
                </Button>
                <TextBlock Classes="app-dialog-setting-caption" Text="{Binding Message}" TextWrapping="Wrap" />
                <TextBlock Classes="app-dialog-setting-caption" IsVisible="{Binding IsEmpty}"
                           Text="Приложение не запрашивает разрешений." TextWrapping="Wrap" />
                <TextBlock Classes="app-dialog-setting-caption" IsVisible="{Binding HasNoSearchResults}"
                           Text="Разрешения не найдены. Попробуйте другое название." TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding VisibleItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppPermissionRowViewModel">
                            <Border Classes="surface-card inset list-card">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="app-dialog-setting-title" Text="{Binding Label}" TextWrapping="Wrap" />
                                    <TextBlock Classes="technical-name" Text="{Binding Name}" />
                                    <TextBlock Classes="app-dialog-setting-caption" Text="{Binding KindText}" TextWrapping="Wrap"
                                               IsVisible="{Binding IsWorkProfile}" />
                                    <Border Classes="tag-chip dense" HorizontalAlignment="Left" IsVisible="{Binding IsWorkProfile}">
                                        <TextBlock Classes="tag-label" Text="{Binding StatusText}" />
                                    </Border>
                                    <TextBlock Classes="app-dialog-setting-caption" Text="{Binding Description}"
                                               IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                                    <TextBlock Classes="app-dialog-setting-caption" Text="{Binding RestrictionReason}"
                                               IsVisible="{Binding ShowRestriction}" TextWrapping="Wrap" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Classes="compact-action" Margin="0,0,8,8"
                                                AutomationProperties.Name="{Binding ActionAutomationName}"
                                                IsVisible="{Binding CanChangePolicy}"
                                                Command="{Binding ChangePolicyCommand}" CommandParameter="{Binding}">
                                            <TextBlock Classes="button-label" Text="{Binding ActionText}" />
                                        </Button>
                                        <Button Classes="compact-action" Margin="0,0,0,8"
                                                AutomationProperties.Name="{Binding RevokeAutomationName}"
                                                IsVisible="{Binding CanRevoke}"
                                                Command="{Binding RevokeCommand}" CommandParameter="{Binding}">
                                            <TextBlock Classes="button-label" Text="Отозвать" />
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
