<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Agnosia.ViewModels"
             x:Class="Agnosia.Views.ModuleIconView"
             x:DataType="vm:AgnosiaModuleViewModel">
    <UserControl.Styles>
        <Style Selector="UserControl.large Border.icon-tile">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
        </Style>
    </UserControl.Styles>
    <Border Classes="icon-tile">
        <Grid>
            <PathIcon Classes="section-icon centered" Data="{StaticResource IconFileShuttleGeometry}"
                      IsVisible="{Binding IsFileShuttle}" />
            <PathIcon Classes="section-icon centered" Data="{StaticResource IconLockdownGeometry}"
                      IsVisible="{Binding IsLockdown}" />
            <PathIcon Classes="section-icon centered" Data="{StaticResource IconVpnGuardGeometry}"
                      IsVisible="{Binding IsVpnGuard}" />
            <PathIcon Classes="section-icon centered" Data="{StaticResource IconRiskEngineGeometry}"
                      IsVisible="{Binding IsRiskEngine}" />
        </Grid>
    </Border>
</UserControl>
