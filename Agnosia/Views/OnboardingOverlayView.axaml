<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Agnosia.Controls"
             xmlns:vm="using:Agnosia.ViewModels"
             xmlns:views="using:Agnosia.Views"
             mc:Ignorable="d"
             x:Class="Agnosia.Views.OnboardingOverlayView"
             x:DataType="vm:DashboardWorkspaceViewModel"
             Classes="overlay-view"
             IsVisible="{Binding IsOnboardingVisible}">
    <Design.DataContext>
        <vm:DashboardWorkspaceViewModel />
    </Design.DataContext>

    <Grid Background="{StaticResource AppBackgroundBrush}"
          RowDefinitions="Auto,*,Auto">
        <Grid Grid.RowSpan="3"
              IsHitTestVisible="False"
              ClipToBounds="True">
            <controls:PlexusBackground LineBrush="{StaticResource AppPlexusLineBrush}"
                                       NodeBrush="{StaticResource AppPlexusNodeBrush}"
                                       GlowBrush="{StaticResource AppPlexusGlowBrush}"
                                       IsVisible="{Binding IsOnboardingVisible}" />
        </Grid>

        <views:AppHeaderView Grid.Row="0" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Classes="content-root">
                <StackPanel IsVisible="{Binding IsOnboardingWelcomeStep}"
                            Spacing="16">
                    <Border Padding="8,10,8,8"
                            Background="Transparent">
                        <Grid ColumnDefinitions="*">
                            <StackPanel MinWidth="0"
                                        Spacing="10">
                                <TextBlock Classes="section-title"
                                           Text="Изолируйте приложения, которым не доверяете" />
                                <TextBlock Classes="page-caption"
                                           Text="Agnosia помогает держать выбранные приложения отдельно от основного профиля телефона и управлять тем, когда они активны." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconWorkGeometry}"
                                                Title="Изоляция в рабочем профиле"
                                                Description="Переносите приложения в отдельный Android-профиль, чтобы их данные и окружение были отделены от личного профиля." />
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconCheckGeometry}"
                                                Title="Контролируемый запуск"
                                                Description="Открывайте изолированные приложения только когда они нужны. После использования Agnosia может снова их остановить." />
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconAppsGeometry}"
                                                Title="Меньше лишних следов"
                                                Description="Настройки Agnosia помогают ограничивать фоновые действия приложений и скрывать нежелательные признаки вашего окружения." />
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconSettingsGeometry}"
                                                Title="Отключение VPN перед запуском"
                                                Description="Agnosia может временно отключать VPN перед открытием рабочего приложения, чтобы оно не увидело адрес VPN-сервера." />
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconLockdownGeometry}"
                                                Title="Устрой им Lockdown"
                                                Description="Модуль Lockdown позволяет заблокировать интернет выбранным приложениям в рабочем профиле." />
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconAlertGeometry}"
                                                Title="Проверка опасности приложений"
                                                Description="Agnosia анализирует разрешения приложений и показывает, какие из них могут собирать слишком много данных." />
                    </Border>

                </StackPanel>

                <StackPanel IsVisible="{Binding IsOnboardingWorkProfileStep}"
                            Spacing="16">
                    <Border Padding="8,10,8,8"
                            Background="Transparent">
                        <StackPanel MinWidth="0"
                                    Spacing="10">
                            <TextBlock Classes="section-title"
                                       Text="Создайте рабочий профиль Android" />
                            <TextBlock Classes="page-caption"
                                       Text="Agnosia откроет мастер создания рабочего профиля. Завершите настройку, затем вернитесь в приложение." />
                        </StackPanel>
                    </Border>

                    <Border Classes="surface-card compact">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Border Classes="icon-tile permission-icon"
                                    Classes.granted="{Binding WorkProfileAvailable}">
                                <PathIcon Classes="section-icon centered"
                                          Data="{StaticResource IconWorkGeometry}" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        MinWidth="0"
                                        Spacing="6">
                                <TextBlock Classes="group-title feature-title"
                                           Text="Текущее состояние" />
                                <TextBlock Classes="page-caption"
                                           Text="{Binding WorkProfileStatusText, Converter={StaticResource LocalizationConverter}, ConverterParameter='String.Dashboard.WP.'}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconWorkGeometry}"
                                                Title="Android создаст отдельное пространство"
                                                Description="В нём будут свои приложения, настройки и данные." />
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconAppsGeometry}"
                                                Title="Agnosia станет администратором профиля"
                                                Description="Android выдаст Agnosia права управления рабочим профилем и приложениями внутри него." />
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconCheckGeometry}"
                                                Title="Вернитесь в Agnosia после настройки"
                                                Description="Когда Android закончит создание профиля, откройте Agnosia снова. Мы проверим профиль и перейдём к разрешениям." />
                    </Border>

                </StackPanel>

                <StackPanel IsVisible="{Binding IsOnboardingPermissionsStep}"
                            Spacing="16">
                    <Border Padding="8,10,8,8"
                            Background="Transparent">
                        <StackPanel MinWidth="0"
                                    Spacing="10">
                            <TextBlock Classes="section-title"
                                       Text="Выдайте необходимые разрешения" />
                            <TextBlock Classes="page-caption"
                                       Text="Без них Agnosia не сможет видеть приложения и управлять изоляцией." />
                        </StackPanel>
                    </Border>

                    <views:PermissionListView Items="{Binding OnboardingPermissionItems}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsOnboardingFinalStep}"
                            Spacing="16">
                    <Border Padding="8,10,8,8"
                            Background="Transparent">
                        <StackPanel MinWidth="0"
                                    Spacing="10">
                            <TextBlock Classes="section-title"
                                       Text="Отлично, Agnosia настроена" />
                            <TextBlock Classes="page-caption"
                                       Text="Рабочий профиль подключён, разрешения выданы, а инструменты изоляции готовы к работе." />
                        </StackPanel>
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconAppsGeometry}"
                                                Title="Выберите приложение из личного профиля"
                                                Description="Откройте карточку приложения и выберите Копировать в рабочий или Переместить в рабочий." />
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconLaunchGeometry}"
                                                Title="Создавайте ярлыки для безопасного запуска"
                                                Description="Ярлык временно откроет рабочее приложение. После использования Agnosia сможет снова его остановить." />
                    </Border>

                    <Border Classes="surface-card compact">
                        <controls:SectionHeader Icon="{StaticResource IconSettingsGeometry}"
                                                Title="Настройки можно изменить позже"
                                                Description="VPN-сценарий, журнал событий и межпрофильный обмен доступны в настройках и карточках приложений." />
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource AppChromeBrush}"
                BorderBrush="{StaticResource AppBorderSoftBrush}"
                BorderThickness="0,1,0,0"
                MinHeight="72">
            <Grid Margin="18,12"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12">
                <Border Grid.Column="0"
                        Classes="tag-chip dense"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsOnboardingPermissionsStep}">
                    <TextBlock Classes="tag-label"
                               Text="{Binding OnboardingPermissionSummary, Converter={StaticResource LocalizationConverter}, ConverterParameter='String.Permission.'}" />
                </Border>

                <Button AutomationProperties.Name="Далее" Classes="primary"
                        Grid.Column="2"
                        Width="172"

                        HorizontalAlignment="Right"
                        IsVisible="{Binding IsOnboardingWelcomeStep}"
                        Command="{Binding StartOnboardingCommand}">
                    <TextBlock Classes="button-label"
                               TextAlignment="Center"
                               Text="Далее" />
                </Button>

                <Grid Grid.Column="0"
                      Grid.ColumnSpan="3"
                      ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="8"
                      RowSpacing="8"
                      IsVisible="{Binding IsOnboardingWorkProfileStep}">
                    <Button AutomationProperties.Name="Создать онлайн"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"

                            Padding="8,4"
                            Command="{Binding StartProvisioningCommand}"
                            IsEnabled="{Binding CanStartProvisioning}">
                        <TextBlock Classes="button-label"
                                   FontSize="13"

                                   TextAlignment="Center"
                                   Text="Создать онлайн" />
                    </Button>
                    <Button AutomationProperties.Name="Создать офлайн" Classes="primary"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"

                            Padding="8,4"
                            Command="{Binding StartOfflineProvisioningCommand}"
                            IsEnabled="{Binding CanStartProvisioning}">
                        <TextBlock Classes="button-label"
                                   FontSize="13"

                                   TextAlignment="Center"
                                   Text="Создать" />
                    </Button>
                    <Button AutomationProperties.Name="Создать через root"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"

                            Padding="8,4"
                            Command="{Binding StartDirectProvisioningCommand}"
                            IsEnabled="{Binding CanStartProvisioning}">
                        <TextBlock Classes="button-label"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   Text="Создать через root" />
                    </Button>
                </Grid>

                <Button AutomationProperties.Name="Далее" Classes="primary"
                        Grid.Column="2"
                        Width="116"

                        HorizontalAlignment="Right"
                        IsVisible="{Binding IsOnboardingPermissionsStep}"
                        Command="{Binding FinishOnboardingCommand}">
                    <TextBlock Classes="button-label"
                               TextAlignment="Center"
                               Text="Далее" />
                </Button>

                <Button AutomationProperties.Name="Открыть приложения" Classes="primary"
                        Grid.ColumnSpan="3"

                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsOnboardingFinalStep}"
                        Command="{Binding FinishOnboardingCommand}">
                    <TextBlock Classes="button-label"
                               TextAlignment="Center"
                               Text="Открыть приложения" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
