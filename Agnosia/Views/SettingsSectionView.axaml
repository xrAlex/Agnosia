<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Agnosia.ViewModels"
             xmlns:controls="using:Agnosia.Controls"
             mc:Ignorable="d"
             x:Class="Agnosia.Views.SettingsSectionView"
             x:DataType="vm:DashboardWorkspaceViewModel">
    <Design.DataContext>
        <vm:DashboardWorkspaceViewModel />
    </Design.DataContext>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Classes="content-root"
                    HorizontalAlignment="Stretch">
            <TextBlock Classes="page-title"
                       Text="Настройки" />

            <StackPanel IsVisible="{Binding IsDashboardVisible}"
                        Spacing="12">

                <Border Classes="surface-card compact">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="14">
                        <controls:SectionHeader Icon="{StaticResource IconCheckGeometry}"
                                                Title="Разрешения"
                                                Description="Выдача разрешений для корректной работы приложения" />
                        <Button AutomationProperties.Name="Открыть разрешения" Grid.Column="1"
                                Classes="icon-button"
                                ToolTip.Tip="Открыть разрешения"
                                VerticalAlignment="Center"
                                Command="{Binding OpenPermissionsCommand}">
                            <PathIcon Classes="action-icon"
                                      Data="{StaticResource IconLaunchGeometry}" />
                        </Button>
                    </Grid>
                </Border>

                <Border Classes="surface-card compact">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="12">
                        <controls:SectionHeader Icon="{StaticResource IconSettingsGeometry}"
                                                Title="Оформление"
                                                Description="Выберите палитру интерфейса" />
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,*,*"
                              ColumnSpacing="10">
                            <Button AutomationProperties.Name="Красная" Classes="segment-chip settings-choice"
                                    Classes.selected="{Binding IsAgnosiaThemeSelected}"
                                    Command="{Binding SelectAgnosiaThemeCommand}">
                                <TextBlock Classes="button-label"
                                           Text="Красная" />
                            </Button>
                            <Button AutomationProperties.Name="Темная" Grid.Column="1"
                                    Classes="segment-chip settings-choice"
                                    Classes.selected="{Binding IsDarkThemeSelected}"
                                    Command="{Binding SelectDarkThemeCommand}">
                                <TextBlock Classes="button-label"
                                           Text="Темная" />
                            </Button>
                            <Button AutomationProperties.Name="Светлая" Grid.Column="2"
                                    Classes="segment-chip settings-choice"
                                    Classes.selected="{Binding IsLightThemeSelected}"
                                    Command="{Binding SelectLightThemeCommand}">
                                <TextBlock Classes="button-label"
                                           Text="Светлая" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border Classes="surface-card compact">
                    <StackPanel Spacing="12">
                        <controls:SectionHeader Icon="{StaticResource IconFileShuttleGeometry}"
                                                Title="Команды рабочего профиля"
                                                Description="Способ связи с рабочим профилем" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Button AutomationProperties.Name="Авто" Classes="segment-chip settings-choice"
                                    Classes.selected="{Binding IsAutoTransportSelected}"
                                    Command="{Binding SelectAutoTransportCommand}">
                                <TextBlock Classes="button-label" Text="Авто" />
                            </Button>
                            <Button AutomationProperties.Name="Provider" Grid.Column="1" Classes="segment-chip settings-choice"
                                    Classes.selected="{Binding IsProviderTransportSelected}"
                                    Command="{Binding SelectProviderTransportCommand}">
                                <TextBlock Classes="button-label" Text="Provider" />
                            </Button>
                            <Button AutomationProperties.Name="Activity" Grid.Column="2" Classes="segment-chip settings-choice"
                                    Classes.selected="{Binding IsActivityTransportSelected}"
                                    Command="{Binding SelectActivityTransportCommand}">
                                <TextBlock Classes="button-label" Text="Activity" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="surface-card compact">
                    <StackPanel Spacing="12">
                        <controls:SectionHeader Icon="{StaticResource IconAppsGeometry}"
                                                Title="Показывать все пакеты"
                                                Description="Отображать в библиотеке системные и служебные приложения вместе с обычными пакетами" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button AutomationProperties.Name="Показывать все пакеты: Вкл"
                                    Classes="segment-chip settings-choice"
                                    Classes.selected="{Binding ShowAllApps}"
                                    Command="{Binding EnableShowAllAppsCommand}">
                                <TextBlock Classes="button-label" Text="Вкл" />
                            </Button>
                            <Button AutomationProperties.Name="Показывать все пакеты: Выкл" Grid.Column="1"
                                    Classes="segment-chip settings-choice"
                                    Classes.selected="{Binding IsShowAllAppsDisabled}"
                                    Command="{Binding DisableShowAllAppsCommand}">
                                <TextBlock Classes="button-label" Text="Выкл" />
                            </Button>
                        </Grid>

                        <Border Classes="divider" />
                        <controls:SectionHeader Icon="{StaticResource IconLogGeometry}"
                                                Title="Логирование"
                                                Description="Сохранять диагностические сообщения в журнале событий" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button AutomationProperties.Name="Логирование: Вкл"
                                    Classes="segment-chip settings-choice"
                                    Classes.selected="{Binding LoggingEnabled}"
                                    Command="{Binding EnableLoggingCommand}">
                                <TextBlock Classes="button-label" Text="Вкл" />
                            </Button>
                            <Button AutomationProperties.Name="Логирование: Выкл" Grid.Column="1"
                                    Classes="segment-chip settings-choice"
                                    Classes.selected="{Binding IsLoggingDisabled}"
                                    Command="{Binding DisableLoggingCommand}">
                                <TextBlock Classes="button-label" Text="Выкл" />
                            </Button>
                        </Grid>

                    </StackPanel>
                </Border>

                <TextBlock Classes="app-version"
                           Text="{Binding AppVersion, StringFormat='Версия {0}'}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
